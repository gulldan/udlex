# OpenSearch 3.10.0. Проверьте версию и наличие analysis-udlex на каждом узле.
GET /

GET /_cat/plugins?v&h=name,component,version&s=name,component

# Используйте свободное имя индекса для этого примера.
PUT /udlex-demo
{
  "settings": {
    "analysis": {
      "filter": {
        "lemma_rus": {"type": "udlex", "language": "rus", "bundle_path": "udlex", "use_rules": true},
        "lemma_eng": {"type": "udlex", "language": "eng", "bundle_path": "udlex", "use_rules": true},
        "lemma_deu": {"type": "udlex", "language": "deu", "bundle_path": "udlex", "use_rules": true},
        "lemma_fra": {"type": "udlex", "language": "fra", "bundle_path": "udlex", "use_rules": true},
        "lemma_spa": {"type": "udlex", "language": "spa", "bundle_path": "udlex", "use_rules": true},
        "lemma_ita": {"type": "udlex", "language": "ita", "bundle_path": "udlex", "use_rules": true},
        "lemma_por": {"type": "udlex", "language": "por", "bundle_path": "udlex", "use_rules": true},
        "lemma_ukr": {"type": "udlex", "language": "ukr", "bundle_path": "udlex", "use_rules": true},
        "lemma_jpn": {"type": "udlex", "language": "jpn", "bundle_path": "udlex", "use_rules": true},
        "lemma_yue": {"type": "udlex", "language": "yue", "bundle_path": "udlex", "use_rules": true}
      },
      "analyzer": {
        "udlex_rus": {"type": "custom", "tokenizer": "standard", "filter": ["lemma_rus", "lowercase"]},
        "udlex_eng": {"type": "custom", "tokenizer": "standard", "filter": ["lemma_eng", "lowercase"]},
        "udlex_deu": {"type": "custom", "tokenizer": "standard", "filter": ["lemma_deu", "lowercase"]},
        "udlex_fra": {"type": "custom", "tokenizer": "standard", "filter": ["lemma_fra", "lowercase"]},
        "udlex_spa": {"type": "custom", "tokenizer": "standard", "filter": ["lemma_spa", "lowercase"]},
        "udlex_ita": {"type": "custom", "tokenizer": "standard", "filter": ["lemma_ita", "lowercase"]},
        "udlex_por": {"type": "custom", "tokenizer": "standard", "filter": ["lemma_por", "lowercase"]},
        "udlex_ukr": {"type": "custom", "tokenizer": "standard", "filter": ["lemma_ukr", "lowercase"]},
        "udlex_jpn": {"type": "custom", "tokenizer": "standard", "filter": ["lemma_jpn", "lowercase"]},
        "udlex_yue": {"type": "custom", "tokenizer": "standard", "filter": ["lemma_yue", "lowercase"]}
      }
    }
  },
  "mappings": {
    "properties": {
      "text": {
        "type": "object",
        "dynamic": "strict",
        "properties": {
          "rus": {"type": "text", "analyzer": "udlex_rus"},
          "eng": {"type": "text", "analyzer": "udlex_eng"},
          "deu": {"type": "text", "analyzer": "udlex_deu"},
          "fra": {"type": "text", "analyzer": "udlex_fra"},
          "spa": {"type": "text", "analyzer": "udlex_spa"},
          "ita": {"type": "text", "analyzer": "udlex_ita"},
          "por": {"type": "text", "analyzer": "udlex_por"},
          "ukr": {"type": "text", "analyzer": "udlex_ukr"},
          "jpn": {"type": "text", "analyzer": "udlex_jpn"},
          "yue": {"type": "text", "analyzer": "udlex_yue"}
        }
      }
    }
  }
}

# Десять документов в одном индексе. Приложение выбирает поле по ISO-коду языка.
POST /udlex-demo/_bulk?refresh=true
{"index": {"_id": "rus"}}
{"text": {"rus": "Играю с котами"}}
{"index": {"_id": "eng"}}
{"text": {"eng": "Two mice"}}
{"index": {"_id": "deu"}}
{"text": {"deu": "Alte Häuser"}}
{"index": {"_id": "fra"}}
{"text": {"fra": "Deux chevaux"}}
{"index": {"_id": "spa"}}
{"text": {"spa": "Muchos libros"}}
{"index": {"_id": "ita"}}
{"text": {"ita": "Due gatti"}}
{"index": {"_id": "por"}}
{"text": {"por": "Dois livros"}}
{"index": {"_id": "ukr"}}
{"text": {"ukr": "Граю з котами"}}
{"index": {"_id": "jpn"}}
{"text": {"jpn": "ネコ"}}
{"index": {"_id": "yue"}}
{"text": {"yue": "一隻貓"}}

# Десять поисков по лемме. В каждом ответе один документ с соответствующим ISO-кодом в _id.
POST /udlex-demo/_msearch
{}
{"query": {"match": {"text.rus": "кот"}}}
{}
{"query": {"match": {"text.eng": "mouse"}}}
{}
{"query": {"match": {"text.deu": "Haus"}}}
{}
{"query": {"match": {"text.fra": "cheval"}}}
{}
{"query": {"match": {"text.spa": "libro"}}}
{}
{"query": {"match": {"text.ita": "gatto"}}}
{}
{"query": {"match": {"text.por": "livro"}}}
{}
{"query": {"match": {"text.ukr": "кіт"}}}
{}
{"query": {"match": {"text.jpn": "猫"}}}
{}
{"query": {"match": {"text.yue": "貓"}}}

# Запрос по двум языкам. Ожидаются документы rus и ukr в любом порядке.
GET /udlex-demo/_search
{"query":{"multi_match":{"query":"котами","fields":["text.rus","text.ukr"]}}}

# Фразовый поиск и подсветка исходной формы «котами».
GET /udlex-demo/_search
{"query":{"match_phrase":{"text.rus":"с котом"}},"highlight":{"fields":{"text.rus":{}}}}
